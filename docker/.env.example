# Base env: ~/work/Docker/.env — consumed by the kanban-centrifugo service.
# Generate both values with: openssl rand -hex 32
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=<generate>
CENTRIFUGO_HTTP_API_KEY=<generate>

# App env: this project's .env — consumed by Symfony.
# CENTRIFUGO_TOKEN_SECRET must equal the base env's
# CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY; CENTRIFUGO_API_KEY must equal
# CENTRIFUGO_HTTP_API_KEY.
CENTRIFUGO_WS_URL=wss://kanban.local/_ws_connection/websocket
CENTRIFUGO_TOKEN_SECRET=<same as CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY>
CENTRIFUGO_URL=http://kanban-centrifugo:8000
CENTRIFUGO_API_KEY=<same as CENTRIFUGO_HTTP_API_KEY>
